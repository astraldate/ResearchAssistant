{
  "name": "researchassistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "pnpm run tauri dev",
    "dev:mobile": "pnpm --dir mobile-app dev",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check:conflicts": "node scripts/check-conflict-markers.mjs",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "workspaces": [
    "mobile-app",
    "packages/*"
  ],
  "pnpm": {
    "patchedDependencies": {
      "@react-native/gradle-plugin@0.83.2": "patches/@react-native__gradle-plugin@0.83.2.patch",
      "expo-modules-core@55.0.15": "patches/expo-modules-core@55.0.15.patch"
    }
  },
  "dependencies": {
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/default-layout": "^3.12.0",
    "@react-pdf-viewer/highlight": "^3.12.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^0.575.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
