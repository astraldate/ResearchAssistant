{
  "name": "researchassistant-mobile",
  "private": true,
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "android:apk:debug": "cd android && gradlew.bat assembleDebug",
    "android:apk:debug:arm64": "cd android && gradlew.bat assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "android:apk:release": "cd android && gradlew.bat assembleRelease",
    "android:install:debug": "cd android && gradlew.bat installDebug",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@radix-ui/react-slot": "1.2.0",
    "@radix-ui/react-tabs": "1.1.12",
    "@tanstack/react-query": "^5.87.1",
    "expo": "~55.0.6",
    "expo-file-system": "~55.0.10",
    "expo-image-picker": "~55.0.12",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.5",
    "expo-secure-store": "~55.0.8",
    "expo-sqlite": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "~5.9.2"
  }
}
