{
  "expo": {
    "name": "Research Assistant Mobile",
    "slug": "researchassistant-mobile",
    "scheme": "researchassistant-mobile",
    "version": "1.1.12",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a2c55"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.researchassistant.mobile",
      "versionCode": 22,
      "usesCleartextTraffic": true,
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a2c55"
      }
    },
    "ios": {
      "bundleIdentifier": "com.researchassistant.mobile"
    }
  }
}
