{
  "expo": {
    "name": "Research Assistant Mobile",
    "slug": "researchassistant-mobile",
    "scheme": "researchassistant-mobile",
    "version": "0.1.4",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4efe5"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.researchassistant.mobile",
      "versionCode": 5,
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f4efe5"
      }
    },
    "ios": {
      "bundleIdentifier": "com.researchassistant.mobile"
    }
  }
}
